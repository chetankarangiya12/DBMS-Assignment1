--Employees whose salary is NOT between $10,000 and $15,000


SELECT first_name, last_name, salary
FROM employees
WHERE salary NOT BETWEEN 10000 AND 15000;
-----------------------------------------------------------
--Employees in departments 30 or 100, in ascending order

SELECT first_name, last_name, department_id
FROM employees
WHERE department_id IN (30, 100)
ORDER BY department_id ASC;
-----------------------------------------------------------
--Employees outside the salary range who belong to department 30 or 100

SELECT first_name, last_name, salary
FROM employees
WHERE salary NOT BETWEEN 10000 AND 15000
  AND department_id IN (30, 100);
-----------------------------------------------------------
--Employees hired in 1987


SELECT first_name, last_name, hire_date
FROM employees
WHERE hire_date >= '1987-01-01'
  AND hire_date < '1988-01-01';
-----------------------------------------------------------
--Employees whose first name contains both “b” and “c”


SELECT first_name
FROM employees
WHERE first_name LIKE '%b%'
  AND first_name LIKE '%c%'
--Programmers or Shipping Clerks whose salary is not $4,500, $10,000, or $15,000


SELECT last_name, job_id, salary
FROM employees
WHERE job_id IN ('Programmer', 'Shipping Clerk')
  AND salary NOT IN (4500, 10000, 15000);
------------------------------------------------------------------------------------
--Employees whose last name has exactly six characters


SELECT last_name
FROM employees
WHERE last_name LIKE '______';
-----------------------------------------------------------------------------------
--Employees whose last name has e as its third character  


SELECT last_name
FROM employees
WHERE last_name LIKE '__e%';
-----------------------------------------------------------------------------------
--Display the jobs/designations available in the employees table


SELECT DISTINCT job_id
FROM employees;
-----------------------------------------------------------------------------------

--Display employee names, salary, and PF (15% of salary)


SELECT first_name,
       last_name,
       salary,
       salary * 0.15 AS PF
FROM employees;
